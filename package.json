{
	"name": "@humanmade/wp-pattern-library",
	"version": "0.1.0",
	"description": "Generate a Markdown pattern library, with screenshots, from a WordPress site's registered block patterns.",
	"license": "GPL-2.0-or-later",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"bin": {
		"pattern-library": "bin/pattern-library.mjs"
	},
	"files": [
		"bin",
		"src",
		"action.yml"
	],
	"keywords": [
		"wordpress",
		"block-patterns",
		"documentation",
		"pattern-library",
		"playwright"
	],
	"dependencies": {
		"playwright": "^1.49.0",
		"sharp": "^0.33.0"
	},
	"allowScripts": {
		"sharp@0.33.5": true
	}
}
